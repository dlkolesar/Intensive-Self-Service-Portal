{
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithAssemblyName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} [{Level}] [{ThreadId}] [{SourceContext}] {Message}{NewLine:1}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\DocsAPI-.txt",
          "outputTemplate": "{Timestamp:G} [{Level}] [{ThreadId}] [{SourceContext}] {Message}{NewLine:1}{Exception}",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "apidocs": "OpenAPIDocs"
}