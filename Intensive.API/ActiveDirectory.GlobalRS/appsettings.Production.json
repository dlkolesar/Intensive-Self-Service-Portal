{
  "ConnectionStrings": {
    "ssDatabase": "Server=1035951-sqlclu;database=SSDatabase; User Id=ssPortal; Password=Nsed3UTR; Connect Timeout=15"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithAssemblyName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} [{Level}] [{ThreadId}] [{SourceContext}] {Message}{NewLine:1}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\ADGlobalRSAPI-.txt",
          "outputTemplate": "{Timestamp:G} [{Level}] [{ThreadId}] [{SourceContext}] {Message}{NewLine:1}{Exception}",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "AdConfigKey": "AD-GlobalRS"

}
